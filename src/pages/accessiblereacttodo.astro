---
import Layout from "../layouts/Layout.astro";
import NavbarPages from "../components/NavbarPages.astro";
import SmallButton from "../components/SmallButton.astro";
import Pagination from "../components/Pagination.astro";
---

<Layout title="accessibleReactTodo | MaDr">
  <NavbarPages use:client />
  <div class="w-full overflow-hidden">
    <div class="w-screen h-[50vh] relative">
      <div class="absolute top-0 left-0 w-full h-[50vh] z-5 bg-black/60"></div>
      <img
        class="absolute z-[-500] left-[50%] top-0 translate-x-[-50%] w-auto h-full object-cover"
        src="https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/accessiblereacttodo.webp"
        alt="/"
      />
      <div
        class="absolute text-3xl font-bold top-[70%] max-w-[1240px] w-full left-[50%] right-[50%] translate-x-[-50%] translate-y-[-50%] text-white p-2 z-100"
      >
        <p class="inline-block bg-black/50 text-white px-2 py-1 rounded-md">
          <h2 class="py-2 text-yellow-400">accessibleReactTodo</h2>
          <h3>React</h3>
        </p>
      </div>
    </div>
    <div class="mx-auto p-10 grid md:grid-cols-5 gap-8 pt-8 bg-black">
      <div class="col-span-4">
        <p class="text-xl font-bold text-yellow-400 mb-4">Description</p>
        <p class="mb-4">accessibleReactTodo project</p>
        <h2 class="text-lg text-blue-600 mb-4">Overview</h2>
        <p class="mb-4">accessibleReactTodo description.</p>
        <a href="https://madr.io/" target="_blank" rel="noreferrer">
          <SmallButton text="Demo" />
        </a>
        <a
          href="https://github.com/MaDrCloudDev/"
          target="_blank"
          rel="noreferrer"
        >
          <SmallButton text="Code" />
        </a>
      </div>
    </div>
    <Pagination nextProject="astroconversion" />
  </div>
</Layout>
