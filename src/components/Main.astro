---
import Socials from './Socials.astro';
---

<div
	id='home'
	class='w-full h-screen text-center'>
	<div
		class='max-w-[1240px] w-full h-full mx-auto p-2 flex justify-center items-center'>
		<div>
			<p class='uppercase text-xl tracking-widest text-yellow-400'>
				Let's build the web together
			</p>
			<h1 class='py-4 text-6xl text-gray-400'>
				Hi, I'm <span class='text-blue-600'>Matt</span>
			</h1>
			<h1 class='py-2 text-4xl text-gray-400'>
				A <span class='text-yellow-400'>Full-stack</span> Web Developer
			</h1>
			<p class='py-4 text-gray-200 max-w-[70%] m-auto'>
				Junior full-stack web developer specializing in HTML, CSS,
				JavaScript & TypeScript. Linux, Node.js, & NoSQL. React,
				Next.js, & Svelte. Jamstack & Vector Design. PWA enthusiast.
			</p>
			<Socials />
		</div>
	</div>
</div>
