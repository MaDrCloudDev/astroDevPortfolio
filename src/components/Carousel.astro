---
// Define TypeScript interfaces
interface Slide {
	url: string;
}

// Define the carousel data
const slides: Slide[] = [
	{
		url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign3.webp',
	},
	{
		url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign2.webp',
	},
	{
		url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign.webp',
	},
];

// Default to first slide
let currentIndex = 0;
---

<div
	class='lg:h-screen md:h-[700px] h-[350px] w-full m-auto py-16 px-4 relative'>
	<div
		id='carousel-slide'
		class='w-full h-full bg-center bg-contain bg-no-repeat'
		style={`background-image: url(${slides[currentIndex].url})`}>
	</div>
	<!-- left arrow -->
	<div
		id='prev-button'
		class='absolute top-[50%] left-5 text-6xl p-2 cursor-pointer text-yellow-400 bg-black/70'>
		&larr;
	</div>
	<!-- right arrow -->
	<div
		id='next-button'
		class='absolute top-[50%] right-5 text-6xl p-2 cursor-pointer text-yellow-400 bg-black/70'>
		→
	</div>
</div>

<script>
	// Get DOM elements
	const slide = document.getElementById('carousel-slide');
	const prevButton = document.getElementById('prev-button');
	const nextButton = document.getElementById('next-button');

	// Define slides in client-side JavaScript
	const slides = [
		{
			url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign3.webp',
		},
		{
			url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign2.webp',
		},
		{
			url: 'https://raw.githubusercontent.com/MaDrCloudDev/projectsImages/master/vectordesign.webp',
		},
	];

	let currentIndex = 0;

	// Update slide display
	function updateSlide() {
		if (slide) {
			slide.style.backgroundImage = `url(${slides[currentIndex].url})`;
		}
	}

	// Previous slide function
	function prevSlide() {
		const isFirstSlide = currentIndex === 0;
		currentIndex = isFirstSlide
			? slides.length - 1
			: currentIndex - 1;
		updateSlide();
	}

	// Next slide function
	function nextSlide() {
		const isLastSlide = currentIndex === slides.length - 1;
		currentIndex = isLastSlide ? 0 : currentIndex + 1;
		updateSlide();
	}

	// Add event listeners
	if (prevButton) {
		prevButton.addEventListener('click', prevSlide);
	}

	if (nextButton) {
		nextButton.addEventListener('click', nextSlide);
	}
</script>
