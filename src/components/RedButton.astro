---
type Props = {
  text: string;
};

const { text } = Astro.props as Props;
---

<button
  class="cursor-not-allowed px-8 py-2 mt-4 mr-8 p-4 rounded-xl text-xl font-bold uppercase bg-gradient-to-r from-red-800 to-red-500 hover:text-yellow-400 hover:from-red-500 hover:to-red-800 shadow-md shadow-gray-700 hover:scale-105 ease-in duration-200"
>
  {text}
</button>
