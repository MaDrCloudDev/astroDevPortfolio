---
type ProjectCardProps = {
	backgroundImg: string;
	title: string;
	projectUrl: string;
	frameWorks: string;
};

const { backgroundImg, title, projectUrl, frameWorks } =
	Astro.props as ProjectCardProps;
---

<div
	class='relative flex items-center justify-center w-full h-auto p-4 shadow-lg shadow-gray-700 rounded-xl group hover:bg-gradient-to-r from-blue-700 to-blue-400'>
	<!-- Image -->
	<img
		class='rounded-xl group-hover:opacity-10'
		src={backgroundImg}
		alt={title}
		width={645}
		height={770}
	/>

	<!-- Text and Links -->
	<div
		class='absolute top-[50%] left-[50%] transform -translate-x-1/2 -translate-y-1/2 hidden group-hover:block'>
		<h3 class='text-2xl text-white tracking-wider text-center'>
			{title}
		</h3>
		<p class='pb-4 pt-2 text-white text-center'>{frameWorks}</p>
		<a href={projectUrl}>
			<p
				class='text-center p-3 border rounded-lg bg-black text-white font-bold text-lg cursor-pointer hover:text-yellow-400 hover:border-yellow-400 hover:scale-105 ease-in duration-200'>
				More Info
			</p>
		</a>
	</div>
</div>
