---
import Sidebar from './Sidebar.astro';
---

<header id='navbar' class={`fixed w-full h-20 z-[100] bg-black`}>
    <nav aria-label='Primary' class='flex py-5 px-3 text-xl'>
        <div class='flex items-center'>
            <a href='/' aria-label='Home'>
                <img src='/MaDrLogo.svg' alt='MaDr Logo' class='h-10 w-auto object-contain block' />
            </a>
        </div>
        <div class='flex-grow flex items-center z-20'>
            <ul class='hidden lg:flex lg:space-x-7 lg:ml-14'>
                <li>
                    <a href='/#home' class='hover:text-yellow-400 transition-colors'>Home</a>
                </li>
                <li>
                    <a href='/#about' class='hover:text-yellow-400 transition-colors'>About</a>
                </li>
                <li>
                    <a href='/#skills' class='hover:text-yellow-400 transition-colors'>Skills</a>
                </li>
                <li>
                    <a href='/#projects' class='hover:text-yellow-400 transition-colors'>Projects</a>
                </li>
                <li>
                    <a href='/#contact' class='hover:text-yellow-400 transition-colors'>Contact</a>
                </li>
            </ul>
        </div>
        <div class='flex items-center'>
            <button
                id='menu-button'
                aria-expanded='false'
                aria-controls='sidebar'
                aria-label='Open Menu'
                class='lg:hidden group transition-opacity duration-300 cursor-pointer'
            >
                <span class='sr-only'>Menu</span>
                <div class='w-8 h-0.5 bg-white mb-2 group-hover:bg-yellow-400 transition-colors'></div>
                <div class='w-8 h-0.5 bg-white mb-2 group-hover:bg-yellow-400 transition-colors'></div>
                <div class='w-8 h-0.5 bg-white group-hover:bg-yellow-400 transition-colors'></div>
            </button>
        </div>
    </nav>
    <Sidebar id='sidebar' />
</header>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuButton = document.getElementById('menu-button');
        const sidebar = document.getElementById('sidebar');
        const navbar = document.getElementById('navbar');

        if (!navbar) return;

        function handleShadow() {
            if (window.scrollY >= 90) {
                navbar.classList.add('shadow-lg', 'shadow-gray-700');
            } else {
                navbar.classList.remove('shadow-lg', 'shadow-gray-700');
            }
        }

        window.addEventListener('scroll', handleShadow);

        function toggleSidebar() {
            if (!sidebar || !menuButton) return;

            if (sidebar.classList.contains('translate-x-0')) {
                sidebar.classList.add('translate-x-full');
                sidebar.classList.remove('translate-x-0');
                menuButton.setAttribute('aria-expanded', 'false');
                menuButton.style.opacity = '1';
                sidebar.setAttribute('aria-hidden', 'true');
            } else {
                sidebar.classList.remove('translate-x-full');
                sidebar.classList.add('translate-x-0');
                menuButton.setAttribute('aria-expanded', 'true');
                menuButton.style.opacity = '0';
                sidebar.setAttribute('aria-hidden', 'false');
            }
        }

        if (menuButton) {
            menuButton.addEventListener('click', toggleSidebar);
        }

        const closeButton = document.getElementById('close-button');
        if (closeButton && menuButton) {
            closeButton.addEventListener('click', () => {
                if (sidebar && menuButton) {
                    sidebar.classList.add('translate-x-full');
                    sidebar.classList.remove('translate-x-0');
                    menuButton.setAttribute('aria-expanded', 'false');
                    menuButton.style.opacity = '1';
                    sidebar.setAttribute('aria-hidden', 'true');
                }
            });
        }

        const nav = document.querySelector('nav');
        const navLinks = nav ? nav.querySelectorAll('a[href^="/#"]') : [];
        const ACTIVE = ['underline', 'decoration-yellow-400', 'underline-offset-8', 'text-yellow-400'];

        /**
         * @param {string} id
         */
        function setActiveLinkById(id) {
            navLinks.forEach((link) => {
                const href = link.getAttribute('href') ?? '';
                const targetId = href.includes('#') ? href.split('#')[1] : '';
                if (targetId && targetId === id) {
                    link.classList.add(...ACTIVE);
                } else {
                    link.classList.remove(...ACTIVE);
                }
            });
        }

        /** @type {HTMLElement[]} */
        const sections = [];
        navLinks.forEach((link) => {
            const href = link.getAttribute('href') ?? '';
            const id = href.includes('#') ? href.split('#')[1] : '';
            const el = id ? document.getElementById(id) : null;
            if (el instanceof HTMLElement) sections.push(el);
        });

        if (sections.length) {
            const observer = new IntersectionObserver((entries) => {
                let topEntry = entries
                    .filter((e) => e.isIntersecting)
                    .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
                if (topEntry?.target?.id) {
                    setActiveLinkById(topEntry.target.id);
                }
            }, { root: null, rootMargin: '-50% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });
            sections.forEach((s) => observer.observe(s));
            if (location.hash) setActiveLinkById(location.hash.replace('#', ''));
        }
    });
</script>
