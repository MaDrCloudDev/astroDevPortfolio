---
import Sidebar from './Sidebar.astro';

let open = false;
let shadow = false;

interface Props {}
---

<header
	id='navbar'
	class={`fixed w-full h-20 z-[100] bg-black ${
		shadow ? 'shadow-lg shadow-gray-700' : ''
	}`}>
	<div class='flex py-5 px-3 text-xl'>
		<div class='flex items-center'>
			<a href='/'>
				<img
					src='/MaDrLogoSmall.svg'
					alt='MaDr Logo'
				/>
			</a>
		</div>
		<div class='flex-grow flex items-center z-20'>
			<ul class='hidden lg:flex lg:space-x-7 lg:ml-14'>
				<a href='/'>
					<li class='hover:text-yellow-400 transition-colors'>
						Home
					</li>
				</a>
				<a href='/#about'>
					<li class='hover:text-yellow-400 transition-colors'>
						About
					</li>
				</a>
				<a href='/#skills'>
					<li class='hover:text-yellow-400 transition-colors'>
						Skills
					</li>
				</a>
				<a href='/#projects'>
					<li class='hover:text-yellow-400 transition-colors'>
						Projects
					</li>
				</a>
				<a href='/#contact'>
					<li class='hover:text-yellow-400 transition-colors'>
						Contact
					</li>
				</a>
			</ul>
		</div>
		<div class='flex items-center'>
			<button
				id='menu-button'
				aria-expanded='false'
				aria-controls='sidebar'
				aria-label='Open Menu'
				class='lg:hidden'>
				<span class='sr-only'>Menu</span>
				<div
					class='w-8 h-0.5 bg-white mb-2 transition-colors hover:bg-yellow-400'>
				</div>
				<div
					class='w-8 h-0.5 bg-white mb-2 transition-colors hover:bg-yellow-400'>
				</div>
				<div
					class='w-8 h-0.5 bg-white transition-colors hover:bg-yellow-400'>
				</div>
			</button>
		</div>
	</div>
	<Sidebar id='sidebar' />
</header>

<script>
	const menuButton = document.getElementById('menu-button');
	const sidebar = document.getElementById('sidebar');
	const navbar = document.getElementById('navbar');

	function handleShadow() {
		if (!navbar) return;
		if (window.scrollY >= 90) {
			navbar.classList.add('shadow-lg', 'shadow-gray-700');
		} else {
			navbar.classList.remove('shadow-lg', 'shadow-gray-700');
		}
	}

	window.addEventListener('scroll', handleShadow);

	function openSidebar() {
		if (!sidebar || !menuButton) return;
		sidebar.setAttribute('data-open', 'true');
		menuButton.setAttribute('aria-expanded', 'true');
	}

	function closeSidebar() {
		if (!sidebar || !menuButton) return;
		sidebar.setAttribute('data-open', 'false');
		menuButton.setAttribute('aria-expanded', 'false');
	}

	if (menuButton) {
		menuButton.addEventListener('click', () => {
			if (!sidebar) return;
			const isOpen = sidebar.getAttribute('data-open') === 'true';
			if (isOpen) {
				closeSidebar();
			} else {
				openSidebar();
			}
		});
	}
</script>
